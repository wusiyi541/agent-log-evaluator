# ============================================
# 智能体日志评测系统 · 配置模板
# 复制本文件为 .env 后填写
# ============================================

# --- Judge 模型配置 ---
# 用于评估答案质量的 LLM（OpenAI 兼容接口均可）
JUDGE_API_BASE=https://api.example.com/v1
JUDGE_API_KEY=your-judge-api-key
JUDGE_MODEL=your-judge-model

# --- 日志文件路径 ---
# 待评测的智能体运行日志（示例见 samples/demo_app.log）
LOG_FILE=samples/demo_app.log

# --- 测试集配置 ---
# 包含问题和标准答案的测试集文件 (Excel 或 JSON)
TEST_SET_FILE=samples/demo_testset.json

# --- Excel 列配置 (仅 Excel 格式需要) ---
# 测试集中问题和答案所在的列索引 (从0开始)
EXCEL_QUESTION_COL=5
EXCEL_ANSWER_COL=10
EXCEL_ID_COL=0
EXCEL_HEADER_ROW=1

# --- 运行控制 ---
# 并发数 / 超时（秒）
JUDGE_CONCURRENCY=3
JUDGE_TIMEOUT=120
